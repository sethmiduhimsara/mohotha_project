# Google Sheets API credentials
# Option A (local): path to the service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=mohotha-project-d02614dc3402.json

# Option B (Vercel): paste email + private key from the JSON
# GOOGLE_SERVICE_ACCOUNT_EMAIL=mohotha-rsvp@mohotha-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 1. Enable Google Sheets API in Google Cloud Console
# 2. Create a Google Sheet in YOUR Google account
# 3. Share it with mohotha-rsvp@mohotha-project.iam.gserviceaccount.com as Editor
# 4. Link it: npm run link:sheet -- wedding-invitation YOUR_SHEET_ID
# 5. Share THAT sheet URL with the couple

# Optional: set per-client sheet IDs when seeding (prefer link:sheet instead)
GOOGLE_SHEET_ID_WEDDING_INVITATION=
GOOGLE_SHEET_ID_KASUN_DEVMINI=
